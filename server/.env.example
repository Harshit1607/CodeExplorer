# CodeExplorer server settings. Copy to `.env` and fill in what you need:
#   cp .env.example .env
# Every setting is optional except GROQ_API_KEY (needed for chat and the AI report).
# Defaults are shown; see app/core/config.py and docs/TechSpecs.md.

# --- LLM (Groq) -------------------------------------------------------------
# Free key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high (gpt-oss models only)
GROQ_REASONING_EFFORT=low
# Characters of repo overview + retrieved code sent with each chat question
CHAT_CONTEXT_CHARS=14000
CHAT_MAX_TOKENS=1536
CHAT_HISTORY_MESSAGES=6

# --- GitHub -----------------------------------------------------------------
# Optional: raises the GitHub API limit for repository metadata (60 requests/hour without it)
GITHUB_TOKEN=

# --- Pipeline ---------------------------------------------------------------
ANALYSIS_WORKERS=8
# Files per file_complexity_batch event
SCAN_BATCH_SIZE=64

# --- Rate limiting (per client, in-memory) -----------------------------------
# Rules are "N/unit" joined with ";" (unit: s|min|minute|h|hour|d|day); "off" disables a rule.
RATE_LIMIT_ENABLED=true
# New analyses only (reconnects are free)
RATE_LIMIT_ANALYZE=3/minute;20/hour
RATE_LIMIT_CHAT=6/minute;100/day
RATE_LIMIT_SEARCH=60/minute
# Trusted reverse proxies in front of the server (client = N-th X-Forwarded-For entry from the right)
RATE_LIMIT_PROXY_HOPS=0
# Global cap on running analyses
MAX_CONCURRENT_ANALYSES=3

# --- Sessions ---------------------------------------------------------------
# Keep finished sessions this long (seconds)
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=20

# --- Vector search ----------------------------------------------------------
VECTOR_SEARCH_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Defaults to server/.cache/fastembed
# EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=4
# Load the embedding model at server start
EMBEDDING_PRELOAD=true
# Bounds indexing time on huge repos
MAX_INDEX_CHUNKS=6000
MAX_CONCURRENT_INDEX_BUILDS=1
